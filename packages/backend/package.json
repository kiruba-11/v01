{
  "name": "@sourcepilot/backend",
  "version": "0.1.0",
  "description": "SourcePilot backend API",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:focused": "vitest",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "express": "^4.18.2",
    "pg": "^8.11.3",
    "pgvector": "^0.1.10",
    "redis": "^4.6.13",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.1.2",
    "zod": "^3.22.4",
    "dotenv": "^16.3.1",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.1",
    "mammoth": "^1.6.0",
    "xlsx": "^0.18.5",
    "pptx-parser": "^0.3.13",
    "sharp": "^0.33.0",
    "node-tesseract-ocr": "^2.2.5",
    "axios": "^1.6.7",
    "cheerio": "^1.0.0-rc.12",
    "html-to-text": "^9.0.5",
    "@anthropic-ai/sdk": "^0.24.3",
    "openai": "^4.47.1",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "cookie-parser": "^1.4.6",
    "express-session": "^1.17.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "@types/pg": "^8.11.2",
    "typescript": "^5.6.3",
    "tsx": "^4.7.0",
    "vitest": "^1.1.0",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0"
  }
}
