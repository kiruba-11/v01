# Backend Configuration
DATABASE_URL=postgresql://sourcepilot:sourcepilot@localhost:5432/sourcepilot
REDIS_URL=redis://localhost:6379
NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

# Frontend Configuration
VITE_API_URL=http://localhost:3001/api
VITE_APP_NAME=SourcePilot

# Universal AI Provider Configuration
# Choose active provider: omniroute | ollama | nvidia | anthropic | openai | gemini | openai-compatible
AI_PROVIDER=omniroute
AI_MODEL=auto/best-chat
AI_EMBEDDING_MODEL=text-embedding-3-small

# 1. Ollama (Local LLM)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama

# 2. OmniRoute
OMNIROUTE_BASE_URL=https://api.omniroute.ai/v1
OMNIROUTE_API_KEY=

# 3. NVIDIA NIM / AI Catalog
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=

# 4. Anthropic Claude API
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_API_KEY=

# 5. OpenAI API
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# 6. Google Gemini API (OpenAI-compatible endpoint)
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_API_KEY=

# 7. Generic OpenAI-Compatible Endpoint (e.g. LM Studio, vLLM, DeepSeek, Groq)
CUSTOM_AI_BASE_URL=
CUSTOM_AI_API_KEY=
CUSTOM_AI_MODEL=

# Search Providers
SERPAPI_API_KEY=
GOOGLE_CUSTOM_SEARCH_API_KEY=
GOOGLE_CUSTOM_SEARCH_ENGINE_ID=

# File Storage
STORAGE_TYPE=local
STORAGE_PATH=./uploads

# Session Configuration
SESSION_SECRET=change-me-in-production
JWT_SECRET=change-me-in-production

# Features
FEATURE_RESEARCH=true
FEATURE_STUDIO=true
FEATURE_ORGANIZATIONS=false
ENABLE_DEEP_READ=true
ENABLE_VISION_PASS=false
